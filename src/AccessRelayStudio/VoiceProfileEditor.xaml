<UserControl x:Class="EliteScriptStudio.VoiceProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent" AllowDrop="True" DragOver="FileDragOver" DragLeave="FileDragLeave" Drop="FileDropped"
          Padding="3,12,10,5">
        <Grid.Resources>
            <Style x:Key="EditorCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioVoiceSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioVoiceOutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>
        <StackPanel Spacing="12">
            <Border x:Name="DropZone" Style="{StaticResource EditorCard}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowSpacing="12" RowDefinitions="Auto,Auto">
                    <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="#8BC7FF" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Drop an audio or video file here" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Choose one local file. Studio extracts the audio track from video automatically."
                                   Foreground="#C1D2E7" TextWrapping="Wrap" />
                        <TextBlock x:Name="FileName" Foreground="#C1D2E7" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="BrowseButton" Grid.Column="1" Grid.Row="1" Content="Browse files…" Click="BrowseClicked" />
                </Grid>
            </Border>
            <Border x:Name="EditCard" Style="{StaticResource EditorCard}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBox x:Name="ProfileName" Header="Profile name" MaxLength="80" TextChanged="ProfileNameChanged"
                             HorizontalAlignment="Left" MinWidth="160" MaxWidth="580" />
                    <ContentPresenter x:Name="TrimHost" HorizontalContentAlignment="Stretch" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Audio cleanup" FontWeight="SemiBold" />
                        <TextBlock Text="Isolate dialogue in the selected audio. You can compare it with the original before saving."
                                   Foreground="#C1D2E7" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RemoveMusicButton" Content="Remove background music" Click="RemoveMusicClicked" IsEnabled="False" />
                            <ProgressRing x:Name="CleanupProgress" Width="20" Height="20" Visibility="Collapsed"
                                          AutomationProperties.Name="Removing background music" />
                        </StackPanel>
                        <CheckBox x:Name="UseCleanedAudio" Content="Use cleaned audio for playback and saving" Visibility="Collapsed"
                                  Checked="PreviewAudioChanged" Unchecked="PreviewAudioChanged" />
                        <TextBlock x:Name="CleanupStatus" Foreground="#C1D2E7" TextWrapping="Wrap" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveButton" Content="Save voice profile" Click="SaveClicked" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Dark">
                                            <StaticResource x:Key="AccentButtonBackground" ResourceKey="StudioAccentBrush" />
                                            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="StudioAccentHoverBrush" />
                                            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="StudioAccentPressedBrush" />
                                            <StaticResource x:Key="AccentButtonForeground" ResourceKey="StudioOnAccentBrush" />
                                            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="StudioOnAccentBrush" />
                                            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="StudioOnAccentBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="ClearButton" Content="Clear clip" Click="ClearClicked" />
                    </StackPanel>
                    <TextBlock x:Name="SaveRequirement" Foreground="#C1D2E7" TextWrapping="Wrap" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ImportStatus" Foreground="#C1D2E7" TextWrapping="Wrap" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
