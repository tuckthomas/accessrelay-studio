<Window x:Class="EliteScriptStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:EliteScriptStudio"
        Title="AccessRelay Studio Beta">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="{StaticResource StudioWindowBrush}" RowDefinitions="45,*,23">
        <Grid.Resources>
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="StudioAccentBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="StudioAccentHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="StudioAccentPressedBrush" />
            <StaticResource x:Key="TextOnAccentFillColorPrimaryBrush" ResourceKey="StudioOnAccentBrush" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#078EF0" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#28A7FF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#0574D0" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#F3F7FC" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#D3E9FC" />
            <LinearGradientBrush x:Key="StudioBlue" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A91F0" Offset="0" />
                <GradientStop Color="#0767D5" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#19212D" Offset="0" />
                <GradientStop Color="#0E141D" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SidebarFill" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#141D28" Offset="0" />
                <GradientStop Color="#101620" Offset="0.72" />
                <GradientStop Color="#171F2C" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelFill}" />
                <Setter Property="BorderBrush" Value="#2F3947" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="11" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#1A212B" />
                <Setter Property="BorderBrush" Value="#303B49" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style x:Key="DashboardCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioVoiceSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioVoiceOutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="PerformanceMeter" TargetType="ProgressBar">
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Foreground" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B5C0CF" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SideItem" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="15,0,10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="TabItem" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="43" />
                <Setter Property="MinWidth" Value="45" />
                <Setter Property="Padding" Value="17,0" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="BorderBrush" Value="#394453" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#1B2430" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioControlOutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="43" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="{StaticResource StudioControlBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioControlOutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidths">
                <VisualState x:Name="ReferenceWidth">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1510" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="MediumWidth">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1270" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="211" />
                        <Setter Target="InspectorColumn.Width" Value="425" />
                        <Setter Target="TopNavigation.Margin" Value="8,10,0,8" />
                        <Setter Target="ThumbnailFrame.Width" Value="48" />
                        <Setter Target="MapFooterLabel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactWidth">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1030" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="169" />
                        <Setter Target="InspectorColumn.Width" Value="355" />
                        <Setter Target="ThumbnailFrame.Visibility" Value="Collapsed" />
                        <Setter Target="TopBindingLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopParametersLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopProfilesLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopCalibrationLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopMonitorLabel.Visibility" Value="Collapsed" />
                        <Setter Target="MapFooterLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ResetBindingsText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowWidth">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="64" />
                        <Setter Target="InspectorColumn.Width" Value="321" />
                        <Setter Target="DeviceCard.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarDashboardLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarBindingsLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarParametersLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarProfilesLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarCalibrationLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarMonitorLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarLibraryLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarRecorderLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarVoiceLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarSettingsLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarUpdatesLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarHelpLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarAboutLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopBindingLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopParametersLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopProfilesLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopCalibrationLabel.Visibility" Value="Collapsed" />
                        <Setter Target="TopMonitorLabel.Visibility" Value="Collapsed" />
                        <Setter Target="MapFooterLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ResetBindingsText.Visibility" Value="Collapsed" />
                        <Setter Target="TitleSubtitle.Visibility" Value="Collapsed" />
                        <Setter Target="TitleDivider.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="StudioTitleBar" Background="#111720" BorderBrush="#303B49" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center" Margin="19,0,0,0">
                <Image Width="30" Height="30" Source="ms-appx:///Assets/AccessRelayStudio.png" Stretch="Uniform"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="TitleBrand" Text="AccessRelay Studio Beta" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Rectangle x:Name="TitleDivider" Fill="#36404D" Width="1" Height="20" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleSubtitle" Text="Assistive input and voice access"
                           FontSize="13" VerticalAlignment="Center" Foreground="#E0E6EF" />
                <TextBlock x:Name="VoiceLiveBadge" Text="● Mic live" Visibility="Collapsed" Foreground="#6FE5D1"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="67,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="268" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="528" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Background="{StaticResource SidebarFill}" BorderBrush="#2C3543" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*" RowSpacing="11" Margin="9,11,9,10">
                    <Border x:Name="DeviceCard" Style="{StaticResource Card}" Padding="9">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="7" MinHeight="50">
                            <Grid x:Name="ThumbnailFrame" Width="67" Height="48" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7FC;" FontSize="29" Foreground="#A8B9CC" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="DeviceName" Text="Controller" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ConnectionLabel" Text="Waiting for a gamepad" FontSize="12" Foreground="#81CFFF" />
                                <TextBlock x:Name="TransportLabel" FontSize="11" Foreground="#A6B4C8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ComboBox x:Name="DevicePicker" Grid.Row="1" Grid.ColumnSpan="2" MinWidth="0" MinHeight="30"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Active input controller"
                                      SelectionChanged="DeviceSelectionChanged" />
                        </Grid>
                    </Border>
                    <ListView x:Name="Navigation" Grid.Row="1" SelectionMode="Single" SelectionChanged="Navigate"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Studio pages">
                        <ListView.Resources>
                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                            <CornerRadius x:Key="ListViewItemCornerRadius">7</CornerRadius>
                            <LinearGradientBrush x:Key="ListViewItemBackgroundSelected" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#097BEB" Offset="0" />
                                <GradientStop Color="#1298E9" Offset="1" />
                            </LinearGradientBrush>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#158FF0" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0868CD" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#253041" />
                        </ListView.Resources>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Dashboard" ToolTipService.ToolTip="Dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE80F;" FontSize="21" />
                                <TextBlock x:Name="SidebarDashboardLabel" Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Bindings" ToolTipService.ToolTip="Bindings">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE7FC;" FontSize="21" />
                                <TextBlock x:Name="SidebarBindingsLabel" Text="Bindings" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Parameters" ToolTipService.ToolTip="Parameters">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE9E9;" FontSize="21" />
                                <TextBlock x:Name="SidebarParametersLabel" Text="Parameters" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Macro profiles" ToolTipService.ToolTip="Macro profiles">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xF0E2;" FontSize="21" />
                                <TextBlock x:Name="SidebarProfilesLabel" Text="Macro profiles" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Calibration" ToolTipService.ToolTip="Calibration">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE81D;" FontSize="21" />
                                <TextBlock x:Name="SidebarCalibrationLabel" Text="Calibration" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Device Monitor" ToolTipService.ToolTip="Device Monitor">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE9D9;" FontSize="21" />
                                <TextBlock x:Name="SidebarMonitorLabel" Text="Device Monitor" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Input Sequences" ToolTipService.ToolTip="Input Sequences">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE943;" FontSize="21" />
                                <TextBlock x:Name="SidebarLibraryLabel" Text="Input Sequences" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Macro Recorder" ToolTipService.ToolTip="Macro Recorder">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE7C8;" FontSize="21" />
                                <TextBlock x:Name="SidebarRecorderLabel" Text="Macro Recorder" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Lua Scripts" ToolTipService.ToolTip="Lua Scripts">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE943;" FontSize="21" />
                                <TextBlock Text="Lua Scripts" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Plugins" ToolTipService.ToolTip="Plugins">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xEA86;" FontSize="21" />
                                <TextBlock Text="Plugins" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Remote Play Vision" ToolTipService.ToolTip="Remote Play Vision (experimental)">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE714;" FontSize="21" />
                                <TextBlock Text="Remote Play Vision" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Voice" ToolTipService.ToolTip="Live Voice">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE720;" FontSize="21" />
                                <TextBlock x:Name="SidebarVoiceLabel" Text="Live Voice" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE713;" FontSize="21" />
                                <TextBlock x:Name="SidebarSettingsLabel" Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Updates" ToolTipService.ToolTip="Updates">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE896;" FontSize="21" />
                                <TextBlock x:Name="SidebarUpdatesLabel" Text="Updates" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="Help &amp; Docs" ToolTipService.ToolTip="Help &amp; Docs">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE82D;" FontSize="21" />
                                <TextBlock x:Name="SidebarHelpLabel" Text="Help &amp; Docs" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Style="{StaticResource SideItem}"
                                      AutomationProperties.Name="About" ToolTipService.ToolTip="About">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <FontIcon Glyph="&#xE946;" FontSize="21" />
                                <TextBlock x:Name="SidebarAboutLabel" Text="About" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

            <ListView x:Name="TopNavigation" Grid.Column="1" Margin="12,11,0,8" SelectionMode="Single"
                      SelectionChanged="TopNavigate" SizeChanged="SizeTopNavigation" AutomationProperties.Name="Studio tabs"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.Resources>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <CornerRadius x:Key="ListViewItemCornerRadius">7</CornerRadius>
                    <SolidColorBrush x:Key="ListViewItemBackground" Color="#1D2531" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2C3A4C" />
                    <LinearGradientBrush x:Key="ListViewItemBackgroundSelected" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0692F5" Offset="0" />
                        <GradientStop Color="#0566D9" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1688F0" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0868CD" />
                </ListView.Resources>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListViewItem Style="{StaticResource TabItem}" AutomationProperties.Name="Bindings" ToolTipService.ToolTip="Bindings">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE7FC;" FontSize="19" />
                        <TextBlock x:Name="TopBindingLabel" Text="Bindings" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Style="{StaticResource TabItem}" AutomationProperties.Name="Parameters" ToolTipService.ToolTip="Parameters">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE9E9;" FontSize="19" />
                        <TextBlock x:Name="TopParametersLabel" Text="Parameters" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Style="{StaticResource TabItem}" AutomationProperties.Name="Macro profiles" ToolTipService.ToolTip="Macro profiles">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xF0E2;" FontSize="19" />
                        <TextBlock x:Name="TopProfilesLabel" Text="Macro profiles" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Style="{StaticResource TabItem}" AutomationProperties.Name="Calibration" ToolTipService.ToolTip="Calibration">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE81D;" FontSize="19" />
                        <TextBlock x:Name="TopCalibrationLabel" Text="Calibration" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Style="{StaticResource TabItem}" AutomationProperties.Name="Device Monitor" ToolTipService.ToolTip="Device Monitor">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE9D9;" FontSize="19" />
                        <TextBlock x:Name="TopMonitorLabel" Text="Device Monitor" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,11,12,8"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel x:Name="MacroProfileActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button Style="{StaticResource IconButton}" Click="Apply" ToolTipService.ToolTip="Save macro profile"
                            AutomationProperties.Name="Save macro profile"><FontIcon Glyph="&#xE74E;" FontSize="17" /></Button>
                    <Button Style="{StaticResource IconButton}" Click="DuplicateActiveProfile" ToolTipService.ToolTip="Duplicate macro profile"
                            AutomationProperties.Name="Duplicate macro profile"><FontIcon Glyph="&#xE8C8;" FontSize="17" /></Button>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" ToolTipService.ToolTip="Studio actions"
                        AutomationProperties.Name="Studio actions">
                    <FontIcon Glyph="&#xE712;" FontSize="17" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Manage macro profiles" Click="ShowProfilePage" />
                            <MenuFlyoutItem Text="Choose input controller" Click="ShowDeviceMonitorPage" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="VirtualOutputMenuItem" Text="Start virtual Xbox output" Click="ToggleOutput" />
                            <MenuFlyoutItem Text="Stop voice, scripts, and output" Click="StopAll" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Border x:Name="WorkspacePanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,6,8" Padding="14,10">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
                    <StackPanel Spacing="3" Margin="3,0,0,0">
                        <TextBlock x:Name="PageTitle" Text="Controller Bindings" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageCaption" Text="Select a control to edit its script assignment." Style="{StaticResource Hint}" />
                    </StackPanel>
                    <local:ControllerScene x:Name="Map" Grid.Row="1" ControlSelected="MapSelected" />
                    <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Details" Spacing="12" />
                    </ScrollViewer>
                    <Grid x:Name="VisionHost" Grid.Row="1" Visibility="Collapsed" />
                    <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="3,4,10,5" RowSpacing="13" ColumnSpacing="13"
                              RowDefinitions="Auto,Auto,Auto" SizeChanged="ArrangeDashboardCards">
                            <Grid.Resources>
                                <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="StudioAccentBrush" />
                                <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="StudioAccentHoverBrush" />
                                <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="StudioAccentPressedBrush" />
                                <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="StudioAccentBrush" />
                                <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="StudioAccentHoverBrush" />
                                <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="StudioAccentPressedBrush" />
                                <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="StudioOnAccentBrush" />
                                <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="StudioOnAccentBrush" />
                                <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="StudioOnAccentBrush" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="DashboardRightColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Macro scripts" FontSize="17" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="DashboardScripts" Grid.Column="1" MinWidth="0" IsEnabled="False"
                                                      AutomationProperties.Name="Macro scripts" Toggled="EnabledChanged" />
                                    </Grid>
                                    <TextBlock Text="Start the virtual Xbox controller and run your assigned sequences." Style="{StaticResource Hint}" />
                                    <ComboBox x:Name="DashboardMacroProfile" Header="Macro profile" MinWidth="0"
                                              HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                              AutomationProperties.Name="Macro profile" SelectionChanged="ProfileChanged" />
                                    <TextBlock x:Name="DashboardMacroProfileNotice" Style="{StaticResource Hint}" Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="DashboardScriptsStatus" Text="Starting controller monitor…"
                                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Open Bindings" Click="OpenBindings" />
                                        <Button Content="Delete macro profile…" Click="DeleteDashboardMacroProfile" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DashboardVoiceCard" Grid.Column="1" Style="{StaticResource DashboardCard}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Live voice" FontSize="17" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="DashboardVoice" Grid.Column="1" MinWidth="0" IsEnabled="False"
                                                      AutomationProperties.Name="Live voice transformation" Toggled="DashboardVoiceChanged" />
                                    </Grid>
                                    <TextBlock Text="Send your transformed voice to AccessRelay Virtual Microphone." Style="{StaticResource Hint}" />
                                    <ComboBox x:Name="DashboardVoiceProfile" Header="Voice profile" MinWidth="0"
                                              HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                              PlaceholderText="Choose a saved voice profile"
                                              AutomationProperties.Name="Voice profile" SelectionChanged="DashboardVoiceProfileChanged" />
                                    <TextBlock x:Name="DashboardVoiceProfileNotice" Style="{StaticResource Hint}" Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="DashboardVoiceStatus" Text="Voice processing is off."
                                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Open Live Voice" Click="OpenVoice" />
                                        <Button x:Name="DashboardDeleteVoiceProfile" Content="Delete voice profile…"
                                                Click="DeleteDashboardVoiceProfile" IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DashboardPerformanceCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DashboardCard}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Live performance" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="Windows resource usage · Updates every second" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="22" RowSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="CPU" Style="{StaticResource Section}" />
                                            <TextBlock x:Name="DashboardCpuValue" Text="Sampling…" Style="{StaticResource Hint}" />
                                            <ProgressBar x:Name="DashboardCpuMeter" Style="{StaticResource PerformanceMeter}" AutomationProperties.Name="System CPU utilization" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="RAM" Style="{StaticResource Section}" />
                                            <TextBlock x:Name="DashboardRamValue" Text="Sampling…" Style="{StaticResource Hint}" />
                                            <ProgressBar x:Name="DashboardRamMeter" Style="{StaticResource PerformanceMeter}" AutomationProperties.Name="System RAM utilization" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="GPU" Style="{StaticResource Section}" />
                                            <TextBlock x:Name="DashboardGpuValue" Text="Sampling…" Style="{StaticResource Hint}" />
                                            <ProgressBar x:Name="DashboardGpuMeter" Style="{StaticResource PerformanceMeter}" AutomationProperties.Name="Busiest GPU engine utilization" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="VRAM" Style="{StaticResource Section}" />
                                            <TextBlock x:Name="DashboardVramValue" Text="Sampling…" Style="{StaticResource Hint}" />
                                            <ProgressBar x:Name="DashboardVramMeter" Style="{StaticResource PerformanceMeter}" AutomationProperties.Name="Dedicated GPU memory utilization" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="DashboardGpuAdapter" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Controller poll interval" Style="{StaticResource Section}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="DashboardPollValue" Text="Sampling…" TextWrapping="Wrap" />
                                            <TextBlock Text="Time between local input samples" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Virtual output handoff" Style="{StaticResource Section}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="DashboardOutputHandoff" Text="Virtual Xbox output is off" TextWrapping="Wrap" />
                                            <TextBlock Text="Latest report from the output queue to the USB/IP pipe" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <Border x:Name="MapFooter" Grid.Row="2" Style="{StaticResource Card}" Padding="7,4" CornerRadius="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <StackPanel x:Name="MapFooterLabel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#95CFFF" />
                                <TextBlock Text="Control Map" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="CenterFooter" Grid.Column="1" Text="Cyan indicates live USB input."
                                       VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="11" />
                            <Button x:Name="ResetBindingsButton" Grid.Column="2" Padding="8,3" Click="ResetBindings"
                                    ToolTipService.ToolTip="Reset all bindings" AutomationProperties.Name="Reset all bindings">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE777;" FontSize="13" />
                                    <TextBlock x:Name="ResetBindingsText" Text="Reset All Bindings" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="BindingsInspector" Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Margin="8,0,8,8" Padding="12,8,12,12">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Bindings Inspector" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Assign a script to the selected control and configure its behavior." Style="{StaticResource Hint}" />
                        <Rectangle Height="1" Fill="#384453" Margin="0,5,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel x:Name="InspectorCards" Spacing="10" Margin="0,0,7,0">
                            <StackPanel Spacing="7">
                                <TextBlock Text="Selected Control" Style="{StaticResource Section}" />
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                    <Border Width="45" Height="42" Background="#141C28" BorderBrush="#424C5A" BorderThickness="1" CornerRadius="7">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="19" Foreground="#A8B9CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="ControlPicker" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="29"
                                                  BorderThickness="0" Background="Transparent" Padding="2,0,20,0" FontWeight="SemiBold"
                                                  AutomationProperties.Name="Selected control" SelectionChanged="ControlChanged" />
                                        <TextBlock x:Name="SelectedControlHint" Margin="2,0,0,0" Text="Rear paddle" Style="{StaticResource Hint}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="31" Height="31" VerticalAlignment="Center" Tag="-1" Click="CycleControl"
                                            AutomationProperties.Name="Previous control" ToolTipService.ToolTip="Previous control">
                                        <FontIcon Glyph="&#xE76B;" FontSize="14" />
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="31" Height="31" VerticalAlignment="Center" Tag="1" Click="CycleControl"
                                            AutomationProperties.Name="Next control" ToolTipService.ToolTip="Next control">
                                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                                    </Button>
                                </Grid>
                                <Rectangle Height="1" Fill="#303B49" Margin="0,1,0,0" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                    <TextBlock Text="Sequence assignment" VerticalAlignment="Center" />
                                    <CheckBox x:Name="BindingEnabled" Grid.Column="1" Content="Enabled" MinWidth="0" MinHeight="24" FontSize="12" Padding="0"
                                              Click="BindingChanged" AutomationProperties.Name="Binding enabled" />
                                    <CheckBox x:Name="ConsumeInput" Grid.Column="2" Content="Consume" MinWidth="0" MinHeight="24" FontSize="12" Padding="0"
                                              Click="BindingChanged" AutomationProperties.Name="Consume assigned button" ToolTipService.ToolTip="Consume the assigned physical button" />
                                </Grid>
                                <ComboBox x:Name="Assignment" HorizontalAlignment="Stretch" AutomationProperties.Name="Script assignment"
                                          BorderBrush="#168DF3" BorderThickness="1" SelectionChanged="AssignmentChanged" />
                            </StackPanel>
                            <Border Style="{StaticResource Card}" Padding="9,7">
                                <StackPanel x:Name="QuickBindings" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                                        <FontIcon Glyph="&#xE9E9;" FontSize="15" />
                                        <TextBlock Text="All Bindings (Quick Edit)" Style="{StaticResource Section}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="TimingCard" Style="{StaticResource Card}" Padding="9,7">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9E9;" FontSize="15" />
                                            <TextBlock Text="Parameters" Style="{StaticResource Section}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ComboBox x:Name="TimingPicker" Grid.Column="1" HorizontalAlignment="Right" MinWidth="0" MinHeight="28"
                                                  AutomationProperties.Name="Timing preset" SelectionChanged="TimingSelected" />
                                    </Grid>
                                    <Grid x:Name="TimingInputs" ColumnDefinitions="*" RowSpacing="2" />
                                    <TextBlock x:Name="TimingHint" Text="Timings in milliseconds · 0 is instant down" Style="{StaticResource Hint}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <Border Style="{StaticResource Card}" Padding="10,2">
                            <ToggleSwitch x:Name="EnableScripts" OffContent="Scripts disabled" OnContent="Scripts enabled"
                                          Toggled="EnabledChanged" AutomationProperties.Name="Enable scripts" />
                        </Border>
                        <Grid ColumnDefinitions="*,1.15*,*" ColumnSpacing="8">
                            <Button Style="{StaticResource ActionButton}" Click="Apply">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE73E;" FontSize="15" /><TextBlock Text="Apply" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Background="{StaticResource StudioBlue}" BorderBrush="#087EEB" Click="ApplyAndTest"
                                    AutomationProperties.Name="Apply &amp; Test">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" FontSize="15" /><TextBlock Text="Apply &amp; Test" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="Revert">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE7A7;" FontSize="15" /><TextBlock Text="Revert" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111720" BorderBrush="#2D3745" BorderThickness="0,1,0,0" Padding="11,2">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="Status" Text="Ready" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RecordingBadge" Grid.Column="1" Content="● Recording" Visibility="Collapsed"
                        Click="OpenRecorder" Foreground="#FF9A9A" Padding="8,2" FontSize="12"
                        AutomationProperties.Name="Open the active macro recording" />
            </Grid>
        </Border>
    </Grid>
</Window>
