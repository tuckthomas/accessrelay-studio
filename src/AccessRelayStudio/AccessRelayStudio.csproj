<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AccessRelayStudio</AssemblyName>
    <Product>AccessRelay Studio Beta</Product>
    <AssemblyTitle>AccessRelay Studio Beta</AssemblyTitle>
    <Description>Assistive controller input and voice access for Windows</Description>
    <PackageLicenseExpression>0BSD</PackageLicenseExpression>
    <Version>1.9.0-beta.18</Version>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AccessRelayStudio.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Verification\**;WindowsVerification\**;Input\Probe\**;Viewer\node_modules\**;DesktopUi\node_modules\**;Audio\VirtualMicHost\target\**;Audio\NeuralHost\**;Run\**;docs\**</DefaultItemExcludes>
    <_VirtualMicIdentityFile>AccessRelay.VirtualMicUsbId.txt</_VirtualMicIdentityFile>
    <_VirtualMicHostFile>AccessRelay.VirtualMicHost.exe</_VirtualMicHostFile>
    <_VirtualMicSourceDirectory>$(MSBuildProjectDirectory)\Audio\VirtualMicHost\</_VirtualMicSourceDirectory>
    <RequireVirtualMicrophone Condition="'$(RequireVirtualMicrophone)' == '' And Exists('$(_VirtualMicSourceDirectory)$(_VirtualMicIdentityFile)')">true</RequireVirtualMicrophone>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AccessRelayStudio.Engine/AccessRelayStudio.Engine.csproj" />
    <ProjectReference Include="../AccessRelayStudio.Application/AccessRelayStudio.Application.csproj" />
    <ProjectReference Include="../AccessRelayStudio.Runtime/AccessRelayStudio.Runtime.csproj" />
    <Compile Include="App.xaml.cs;DesktopWindow.xaml.cs;BuildInfo.cs;Desktop/*.cs;Diagnostics/*.cs" />
    <Content Include="../../games/nba2k27/pack.json" TargetPath="GamePacks/nba2k27/pack.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../games/nba2k27/scripts/*.lua" TargetPath="GamePacks/nba2k27/scripts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../games/switch-demo/pack.json" TargetPath="GamePacks/switch-demo/pack.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../games/switch-demo/scripts/*.lua" TargetPath="GamePacks/switch-demo/scripts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="DesktopUi\dist\**\*" TargetPath="DesktopUi\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="DesktopUi/src/tokens.css" TargetPath="Scene/Viewer/theme-tokens.css"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.31.1" GeneratePathProperty="true" />
    <None Update="Audio\DialogueSeparation\*.md;Audio\DialogueSeparation\*.txt">
      <TargetPath>DialogueSeparation\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\LICENSE" Condition="'$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)' != ''"
          TargetPath="DialogueSeparation\ONNX-RUNTIME-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\ThirdPartyNotices.txt" Condition="'$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)' != ''"
          TargetPath="DialogueSeparation\ONNX-RUNTIME-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Audio\VirtualMicHost\AccessRelay.VirtualMicHost.exe;Audio\VirtualMicHost\AccessRelay.VirtualMicUsbId.txt;Audio\VirtualMicHost\PlaySignal.VirtualMicHost.LICENSE.txt;Audio\VirtualMicHost\usbip-audio.LICENSE.txt;Audio\VirtualMicHost\windows-rs.LICENSE.txt;Audio\VirtualMicHost\README.md">
      <TargetPath>VirtualMicrophone\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Audio\VirtualMicDriver\Package\*">
      <TargetPath>VirtualMicrophone\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Audio\VirtualMicHost\AccessRelay.VirtualXboxHost.exe;Audio\VirtualMicHost\ViGEmBus.LICENSE.txt;Audio\VirtualMicHost\XBOX360.PROVENANCE.md">
      <TargetPath>VirtualController\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\*.png;Assets\*.ico;Assets\*.webp;Assets\*.jpg;Assets\*.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Viewer\index.html;Viewer\viewer.css;Viewer\viewer.bundle.js;Viewer\THIRD-PARTY-NOTICES.md">
      <TargetPath>Scene\Viewer\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Model\XboxOne.glb;Model\EliteSeries2Articulated.glb;Model\DualShock4.glb;Model\SwitchPro.glb;Model\*.txt;Model\*.md">
      <TargetPath>Scene\Model\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="PublishAssistantBridge" AfterTargets="Publish">
    <MSBuild Projects="../AccessRelayStudio.Mcp/AccessRelayStudio.Mcp.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))Mcp/" />
  </Target>
  <Target Name="ValidateXamlOutputPath" BeforeTargets="PrepareForBuild">
    <!-- WinUI appends resource names to OutputPath when compiling XAML. -->
    <Error Condition="'$(OutputPath)' != '' And !HasTrailingSlash('$(OutputPath)')"
           Text="WinUI requires a trailing slash on a custom build output path. Add a trailing slash or use dotnet publish for the runnable folder." />
  </Target>
  <Target Name="ValidateDesktopInterface" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/DesktopUi/dist/index.html')"
           Text="Build the bundled desktop interface with scripts/Build-DesktopUi.ps1 before building the Windows app." />
  </Target>
  <Target Name="ValidateVirtualMicrophoneInputs" BeforeTargets="PrepareForBuild;PrepareForPublish" Condition="'$(RequireVirtualMicrophone)' == 'true'">
    <Error Condition="!Exists('$(_VirtualMicSourceDirectory)$(_VirtualMicIdentityFile)') Or !Exists('$(_VirtualMicSourceDirectory)$(_VirtualMicHostFile)')"
           Text="Virtual microphone output was requested. Stage its USB identity and helper with scripts/Build-VirtualDevices.ps1 before building." />
  </Target>
  <Target Name="ValidatePublishedVirtualMicrophone" AfterTargets="Publish" Condition="'$(RequireVirtualMicrophone)' == 'true'">
    <Error Condition="!Exists('$(PublishDir)VirtualMicrophone\$(_VirtualMicIdentityFile)') Or !Exists('$(PublishDir)VirtualMicrophone\$(_VirtualMicHostFile)')"
           Text="The published VirtualMicrophone folder is missing its USB identity or helper." />
  </Target>
</Project>
