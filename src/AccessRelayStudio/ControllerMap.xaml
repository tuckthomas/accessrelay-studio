<UserControl x:Class="EliteScriptStudio.ControllerMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="False">
    <UserControl.Resources>
        <Style x:Key="MapCallout" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#F5F8FC" />
        </Style>
        <Style x:Key="MapHotspot" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="SchematicSurface" Width="812" Height="696">
