<UserControl x:Class="EliteScriptStudio.Nba2K27PluginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PluginCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StudioVoiceSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioVoiceOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="PluginHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PluginHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B5C0CF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FeedbackBadge" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Badge" Background="{StaticResource StudioControlBrush}"
                                BorderBrush="{StaticResource StudioControlOutlineBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Badge.Background" Value="{StaticResource StudioControlHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Badge.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Badge.Opacity" Value="0.55" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Badge.BorderBrush" Value="{StaticResource StudioAccentHoverBrush}" />
                                            <Setter Target="CheckMark.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <FontIcon x:Name="CheckMark" Glyph="&#xE73E;" FontSize="12" Opacity="0"
                                          Foreground="{StaticResource StudioAccentHoverBrush}" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12" Margin="3,4,10,5" MaxWidth="900">
        <Border Style="{StaticResource PluginCard}">
            <StackPanel Spacing="10">
                <TextBlock Text="NBA 2K27 shot profiles" FontSize="22" Style="{StaticResource PluginHeading}" />
                <TextBlock Text="Save the player build and jump-shot creator settings for each shot. Vision keeps training and calibration tied to this configuration. Selecting a profile does not arm assistance."
                           Style="{StaticResource PluginHint}" />
                <ComboBox x:Name="ShotProfilePicker" Header="Saved shot profile" PlaceholderText="Create a shot profile"
                          DisplayMemberPath="Name" FontSize="14" HorizontalAlignment="Stretch" MinWidth="0"
                          AutomationProperties.Name="Saved NBA 2K27 shot profile" SelectionChanged="ShotProfileSelectionChanged" />
                <StackPanel x:Name="ShotProfileFields" Spacing="10">
                    <TextBox x:Name="ShotProfileName" Header="Profile name" MaxLength="80" FontSize="14"
                             AutomationProperties.Name="Shot profile name" TextChanged="ShotTextChanged" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <NumberBox x:Name="ShotPlayerHeight" Header="Player height (total inches)" Minimum="36" Maximum="108"
                                   SmallChange="1" LargeChange="12" SpinButtonPlacementMode="Compact" FontSize="14" MinWidth="0"
                                   AutomationProperties.Name="Player height in whole inches" ValueChanged="ShotNumberChanged" />
                        <NumberBox x:Name="ShotThreePointRating" Grid.Column="1" Header="Three-point rating" Minimum="0" Maximum="100"
                                   SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact" FontSize="14" MinWidth="0"
                                   AutomationProperties.Name="Three point rating from zero to one hundred" ValueChanged="ShotNumberChanged" />
                    </Grid>
                    <TextBlock x:Name="ShotHeightHint" Style="{StaticResource PluginHint}" />
                    <TextBox x:Name="ShotBase" Header="Base" PlaceholderText="Enter the base exactly as configured in the game"
                             MaxLength="120" FontSize="14" AutomationProperties.Name="Jump shot base" TextChanged="ShotTextChanged" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBox x:Name="ShotUpperRelease1" Header="Upper release 1" MaxLength="120" FontSize="14" MinWidth="0"
                                 AutomationProperties.Name="Upper release one" TextChanged="ShotTextChanged" />
                        <TextBox x:Name="ShotUpperRelease2" Grid.Column="1" Header="Upper release 2" MaxLength="120" FontSize="14" MinWidth="0"
                                 AutomationProperties.Name="Upper release two" TextChanged="ShotTextChanged" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <NumberBox x:Name="ShotRelease1Percent" Header="Upper release 1 blend (%)" Minimum="0" Maximum="100"
                                   SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" FontSize="14" MinWidth="0"
                                   AutomationProperties.Name="Upper release one blend percentage" ValueChanged="ShotBlend1Changed" />
                        <NumberBox x:Name="ShotRelease2Percent" Grid.Column="1" Header="Upper release 2 blend (%)" Minimum="0" Maximum="100"
                                   SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" FontSize="14" MinWidth="0"
                                   AutomationProperties.Name="Upper release two blend percentage" ValueChanged="ShotBlend2Changed" />
                    </Grid>
                    <TextBlock Text="The two upper-release percentages always total 100%. Changing either value updates the other."
                               Style="{StaticResource PluginHint}" />
                    <ComboBox x:Name="ShotSpeed" Header="Shot speed" FontSize="14" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Shot speed from one to four" SelectionChanged="ShotSpeedChanged">
                        <ComboBoxItem Content="1 of 4 (slowest)" />
                        <ComboBoxItem Content="2 of 4" />
                        <ComboBoxItem Content="3 of 4" />
                        <ComboBoxItem Content="4 of 4 (fastest)" />
                    </ComboBox>
                    <ToggleSwitch x:Name="ShotUsesMeter" Header="Use shot meter" OnContent="Meter on" OffContent="Meter off"
                                  FontSize="14" AutomationProperties.Name="Use a shot meter for this shot profile" Toggled="ShotMeterChanged" />
                    <TextBox x:Name="ShotMeterReleaseType" Header="Meter release type" MaxLength="120" FontSize="14"
                             PlaceholderText="Enter the release type configured for the meter"
                             AutomationProperties.Name="Release type used with the shot meter" TextChanged="ShotTextChanged" />
                    <TextBlock Text="Release type applies only while the shot meter is on. Meter-free animation analysis remains available with the meter off."
                               Style="{StaticResource PluginHint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NewShotProfileButton" Content="New profile" FontSize="14" Click="NewShotProfileClicked" />
                    <Button x:Name="SaveShotProfileButton" Content="Save profile" FontSize="14" Click="SaveShotProfileClicked"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="RevertShotProfileButton" Content="Revert edits" FontSize="14" Click="RevertShotProfileClicked" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DuplicateShotProfileButton" Content="Duplicate profile" FontSize="14" Click="DuplicateShotProfileClicked" />
                    <Button x:Name="DeleteShotProfileButton" Content="Delete profile…" FontSize="14" Click="DeleteShotProfileClicked" />
                </StackPanel>
                <TextBlock x:Name="ShotProfileStatus" Style="{StaticResource PluginHint}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource PluginCard}">
            <StackPanel Spacing="9">
                <TextBlock Text="NBA 2K27 Rhythm Shooting" FontSize="22" Style="{StaticResource PluginHeading}" />
                <TextBlock Text="Load an existing macro or shot script from your active macro profile."
                           Style="{StaticResource PluginHint}" />
                <TextBlock x:Name="ProfileInfo" Style="{StaticResource PluginHint}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox x:Name="MacroPicker" PlaceholderText="Choose a macro or shot script"
                              DisplayMemberPath="Label" HorizontalAlignment="Stretch" MinWidth="0"
                              AutomationProperties.Name="Macro or shot script" SelectionChanged="MacroSelectionChanged" />
                    <Button x:Name="LoadMacroButton" Grid.Column="1" Content="Load macro" Click="LoadMacroClicked"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                </Grid>
                <TextBlock x:Name="LoadedMacroInfo" Text="Choose a macro to get started."
                           Style="{StaticResource PluginHint}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource PluginCard}">
            <StackPanel Spacing="10">
                <TextBlock Text="Shot feedback" Style="{StaticResource PluginHeading}" />
                <TextBlock Text="Pick the feedback you see after taking the same shot several times."
                           Style="{StaticResource PluginHint}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Timing" FontWeight="SemiBold" />
                    <TextBlock Text="Choose Early to start the flick later, or Late to start it sooner."
                               Style="{StaticResource PluginHint}" />
                    <RadioButtons x:Name="TimingFeedback" AutomationProperties.Name="Shot timing feedback"
                                  MaxColumns="6" IsEnabled="False" SelectionChanged="FeedbackChanged">
                        <RadioButton Content="No change" Tag="None" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Early" Tag="Early" Foreground="#FFC2A8" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Slightly early" Tag="SlightlyEarly" Foreground="#FFD791" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Excellent" Tag="Excellent" Foreground="#93EDAE" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Slightly late" Tag="SlightlyLate" Foreground="#FFD791" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Late" Tag="Late" Foreground="#FFC2A8" Style="{StaticResource FeedbackBadge}" />
                    </RadioButtons>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Tempo" FontWeight="SemiBold" />
                    <TextBlock Text="Choose Fast to slow the flick down, or Slow to speed it up."
                               Style="{StaticResource PluginHint}" />
                    <RadioButtons x:Name="TempoFeedback" AutomationProperties.Name="Shot tempo feedback"
                                  MaxColumns="6" IsEnabled="False" SelectionChanged="FeedbackChanged">
                        <RadioButton Content="No change" Tag="None" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Fast" Tag="Fast" Foreground="#FFC2A8" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Slightly fast" Tag="SlightlyFast" Foreground="#FFD791" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Excellent" Tag="Excellent" Foreground="#93EDAE" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Slightly slow" Tag="SlightlySlow" Foreground="#FFD791" Style="{StaticResource FeedbackBadge}" />
                        <RadioButton Content="Slow" Tag="Slow" Foreground="#FFC2A8" Style="{StaticResource FeedbackBadge}" />
                    </RadioButtons>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource PluginCard}">
            <StackPanel Spacing="10">
                <TextBlock Text="Adjustment preview" Style="{StaticResource PluginHeading}" />
                <TextBlock Text="Current → proposed" Style="{StaticResource PluginHint}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Down hold · When the flick starts" Style="{StaticResource PluginHint}" />
                        <TextBlock x:Name="DownHoldPreview" Text="—" Style="{StaticResource PluginHeading}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Up sweep · How fast the stick moves" Style="{StaticResource PluginHint}" />
                        <TextBlock x:Name="UpSweepPreview" Text="—" Style="{StaticResource PluginHeading}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ApplyTuningButton" Content="Apply to macro" Click="ApplyTuningClicked"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                    <Button x:Name="UndoTuningButton" Content="Undo last apply" Click="UndoTuningClicked" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="TuningStatus" Style="{StaticResource PluginHint}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
