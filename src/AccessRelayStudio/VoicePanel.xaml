<UserControl x:Class="EliteScriptStudio.VoicePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="VoiceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StudioVoiceSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioVoiceOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </UserControl.Resources>
    <TabView x:Name="VoiceTabs" SelectedIndex="0" TabWidthMode="SizeToContent" IsAddTabButtonVisible="False"
             CanDragTabs="False" CanReorderTabs="False" SelectionChanged="VoiceTabChanged"
             Margin="3,4,10,5" AutomationProperties.Name="Live Voice tabs">
        <TabViewItem Header="Voice controls" IsClosable="False">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="13" ColumnSpacing="13" MaxWidth="1080"
                  HorizontalAlignment="Stretch" Margin="3,4,10,5" SizeChanged="ArrangeCards">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="VoiceRightColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource VoiceCard}">
                    <StackPanel Spacing="11">
                        <TextBlock Text="Audio routing" FontSize="17" FontWeight="SemiBold" />
                        <ComboBox x:Name="Microphone" Header="Microphone input" HorizontalAlignment="Stretch"
                                  SelectionChanged="RouteChanged" />
                        <ComboBox x:Name="Playback" Header="Headphone playback" HorizontalAlignment="Stretch"
                                  Visibility="Collapsed" SelectionChanged="RouteChanged" />
                        <CheckBox x:Name="HeadphoneMode" Content="Headphone preview" Checked="PreviewChanged" Unchecked="PreviewChanged"
                                  ToolTipService.ToolTip="Listen to the processed voice locally." />
                        <TextBlock x:Name="RouteHelp" TextWrapping="Wrap" Foreground="#C1D2E7" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartStop" Content="Start virtual mic" Style="{StaticResource AccentButtonStyle}"
                                    Click="ToggleVoice" IsEnabled="False">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Dark">
                                                <StaticResource x:Key="AccentButtonBackground" ResourceKey="StudioAccentBrush" />
                                                <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="StudioAccentHoverBrush" />
                                                <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="StudioAccentPressedBrush" />
                                                <StaticResource x:Key="AccentButtonForeground" ResourceKey="StudioOnAccentBrush" />
                                                <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="StudioOnAccentBrush" />
                                                <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="StudioOnAccentBrush" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="RefreshDevices" Content="Refresh devices" Click="RefreshClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="TransformCard" Grid.Column="1" Style="{StaticResource VoiceCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Voice access" FontSize="17" FontWeight="SemiBold" />
                        <ComboBox x:Name="Model" Header="AI model" HorizontalAlignment="Stretch" SelectionChanged="ModelChanged" />
                        <TextBlock x:Name="ModelHelp" TextWrapping="Wrap" Foreground="#C1D2E7" />
                        <ComboBox x:Name="Profile" Header="Voice profile" PlaceholderText="Choose an imported voice reference"
                                  HorizontalAlignment="Stretch" SelectionChanged="ProfileChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Create voice profile" Click="OpenVoiceProfileEditor" />
                            <Button x:Name="DeleteVoiceProfileButton" Content="Delete voice profile…" Click="DeleteVoiceProfile"
                                    IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="DeleteVoiceProfileHint" Text="Stop voice processing to delete this profile."
                                   Foreground="#C1D2E7" TextWrapping="Wrap" Visibility="Collapsed" />
                        <ComboBox x:Name="Preset" Header="Voice preset" HorizontalAlignment="Stretch" SelectionChanged="SettingsChanged" />
                        <Slider x:Name="Pitch" Minimum="-8" Maximum="8" StepFrequency="0.5" ValueChanged="SettingValueChanged" />
                        <Slider x:Name="Gain" Minimum="-18" Maximum="12" StepFrequency="1" ValueChanged="SettingValueChanged" />
                        <ToggleSwitch x:Name="Mute" Header="Mute output" OnContent="Muted" OffContent="Unmuted" Toggled="SettingsChanged" />
                        <Button x:Name="SaveEffectsProfileButton" Content="Save effects profile…" Click="SaveEffectsProfileClicked" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource VoiceCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Signal levels" FontSize="17" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="95,*" RowDefinitions="Auto,Auto" RowSpacing="9" ColumnSpacing="8">
                            <TextBlock Text="Microphone" VerticalAlignment="Center" />
                            <ProgressBar x:Name="InputMeter" Grid.Column="1" AutomationProperties.Name="Microphone level" />
                            <TextBlock Grid.Row="1" Text="Processed" VerticalAlignment="Center" />
                            <ProgressBar x:Name="OutputMeter" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Processed level" />
                        </Grid>
                        <TextBlock x:Name="SessionStatus" Text="Voice is off." TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" Foreground="#C1D2E7" />
                        <TextBlock x:Name="BufferStatus" TextWrapping="Wrap" Foreground="#C1D2E7" />
                    </StackPanel>
                </Border>
            </Grid>
        </TabViewItem>
        <TabViewItem x:Name="CreateVoiceProfileTab" Header="Create voice profile" IsClosable="False">
            <ContentPresenter x:Name="CreateVoiceProfileHost" HorizontalContentAlignment="Stretch" />
        </TabViewItem>
    </TabView>
</UserControl>
