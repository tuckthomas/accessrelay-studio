<UserControl x:Class="EliteScriptStudio.ControllerScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:EliteScriptStudio">
    <Grid RowDefinitions="Auto,*" RowSpacing="4">
        <StackPanel Orientation="Horizontal" Spacing="9" Margin="5,2,5,0">
            <TextBlock Text="Controller model" VerticalAlignment="Center" FontSize="13" />
            <ComboBox x:Name="ModelPicker" MinWidth="180" MinHeight="28" Padding="8,3,27,3"
                      AutomationProperties.Name="Controller model" SelectionChanged="ModelChanged" />
        </StackPanel>
        <Grid Grid.Row="1">
            <local:ControllerMap x:Name="SchematicMap" Visibility="Collapsed" ControlSelected="SchematicSelected" />
            <WebView2 x:Name="Viewport" Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                      AutomationProperties.Name="Interactive 3D controller layout" />
            <Border x:Name="SceneNotice" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="6" Padding="10,5" Background="#182331" BorderBrush="#415875"
                    BorderThickness="1" CornerRadius="6" IsHitTestVisible="False">
                <TextBlock x:Name="SceneStatus" Text="Loading the 3D control layout…" TextWrapping="Wrap"
                           Foreground="#C9DCFA" FontSize="12" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
