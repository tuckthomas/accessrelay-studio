<UserControl x:Class="EliteScriptStudio.RecorderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RecorderCard" TargetType="Border">
            <Setter Property="Background" Value="#1A212B" />
            <Setter Property="BorderBrush" Value="#303B49" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="RecorderHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RecorderHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B5C0CF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RecorderWorkspace" ColumnDefinitions="*,0" RowDefinitions="Auto,Auto"
          RowSpacing="10" SizeChanged="WorkspaceWidthChanged">
        <Border Grid.Row="0" VerticalAlignment="Top" Style="{StaticResource RecorderCard}">
            <StackPanel Spacing="9">
                <TextBlock Text="1. Record" FontSize="19" Style="{StaticResource RecorderHeading}" />
                <ComboBox x:Name="CapturePreset" Header="What to record" MinWidth="0" HorizontalAlignment="Stretch"
                          SelectionChanged="CapturePresetChanged">
                    <x:String>All inputs</x:String>
                    <x:String>Right stick only</x:String>
                    <x:String>Ignore left stick</x:String>
                    <x:String>Custom</x:String>
                </ComboBox>
                <TextBlock x:Name="FilterSummary" Style="{StaticResource RecorderHint}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Ellipse x:Name="CaptureIndicator" Width="8" Height="8" Fill="#8FA9C7"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="CaptureStatus" Grid.Column="1" Text="Connect a controller to start"
                               TextWrapping="Wrap" Style="{StaticResource RecorderHeading}"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <TextBlock Text="Press or move an included control on your physical gamepad. Scripts pause during recording."
                           Style="{StaticResource RecorderHint}" />
                <StackPanel x:Name="CaptureProgress" Spacing="4" Visibility="Collapsed">
                    <ProgressBar x:Name="CaptureBar" Minimum="0"
                                 AutomationProperties.Name="Recording progress" />
                    <TextBlock x:Name="CaptureTime" Style="{StaticResource RecorderHint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartButton" Content="Start recording" Click="StartClicked"
                            IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="StopButton" Content="Stop &amp; review" Click="StopClicked"
                            IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <TextBlock x:Name="CaptureNote" Style="{StaticResource RecorderHint}" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite" />
                <Expander x:Name="FiltersExpander" Header="Custom input filters" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Checked inputs are recorded. Unchecked inputs stay manual during playback."
                                   Style="{StaticResource RecorderHint}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SelectAllFilters" Content="Select all" Click="SelectAllClicked" />
                            <Button x:Name="ClearFilters" Content="Clear selection" Click="ClearSelectionClicked" />
                        </StackPanel>
                        <Grid x:Name="FilterGroups" ColumnSpacing="12" RowSpacing="10" SizeChanged="FilterWidthChanged" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border x:Name="ReviewCard" Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource RecorderCard}">
            <StackPanel Spacing="9">
                <TextBlock Text="2. Review &amp; save" FontSize="19" Style="{StaticResource RecorderHeading}" />
                <TextBlock x:Name="ReviewSummary" Style="{StaticResource RecorderHint}"
                           Text="Your recording will appear here after you stop."
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="SaveTarget" Text="Saves to the active macro profile."
                           Style="{StaticResource RecorderHint}" />
                <TextBox x:Name="RecordingName" Header="Recording name" PlaceholderText="e.g. Fadeaway"
                         IsEnabled="False" MaxLength="80" TextChanged="RecordingNameChanged" />
                <ComboBox x:Name="PaddlePicker" Header="Bind to a paddle (optional)" MinWidth="0"
                          IsEnabled="False" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="NameError" Text="Enter a name for this recording." Visibility="Collapsed"
                           Style="{StaticResource RecorderHint}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveProfileButton" Content="Save macro" IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" Click="SaveClicked" />
                    <Button x:Name="RecordAgainButton" Content="Record again" IsEnabled="False" Click="RecordAgainClicked" />
                    <Button x:Name="DiscardButton" Content="Discard recording" IsEnabled="False" Click="DiscardClicked" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyJsonButton" Content="Copy JSON" IsEnabled="False" Click="CopyJsonClicked" />
                    <Button x:Name="SaveJsonButton" Content="Export JSON" IsEnabled="False" Click="SaveJsonClicked" />
                </StackPanel>
                <TextBox x:Name="RecordingJson" Header="Recorded macro JSON" Height="260" FontFamily="Consolas"
                         PlaceholderText="No recorded inputs yet."
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <TextBlock x:Name="ReviewStatus" Style="{StaticResource RecorderHint}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
