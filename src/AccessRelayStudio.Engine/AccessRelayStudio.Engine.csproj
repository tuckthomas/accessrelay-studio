<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EliteScriptStudio.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AccessRelayStudio/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <InternalsVisibleTo Include="AccessRelayStudio.Runtime" />
    <InternalsVisibleTo Include="AccessRelayStudio.Application" />
    <InternalsVisibleTo Include="AccessRelayStudio" />
    <InternalsVisibleTo Include="Verification" />
    <InternalsVisibleTo Include="WindowsVerification" />
    <InternalsVisibleTo Include="VisionModelVerification" />
    <InternalsVisibleTo Include="DesktopEvidenceVerification" />
    <InternalsVisibleTo Include="PackTool" />
    <InternalsVisibleTo Include="AccessRelay.PluginVerification" />
  </ItemGroup>
</Project>
