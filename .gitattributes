* text=auto

# Bundled game-pack resource hashes cover exact bytes on every checkout.
/src/AccessRelayStudio/Verification/Fixtures/**/scripts/*.lua text eol=lf
/src/AccessRelayStudio/Verification/Fixtures/**/pack.json text eol=lf

# Keep the signed USB/IP package byte-for-byte identical to upstream.
/src/AccessRelayStudio/Audio/VirtualMicDriver/Package/usbip2_ude.inf binary
/src/AccessRelayStudio/Audio/VirtualMicDriver/Package/usbip2_ude.sys binary
/src/AccessRelayStudio/Audio/VirtualMicDriver/Package/usbip2_ude.cat binary
/src/AccessRelayStudio/Audio/VirtualMicDriver/Package/*.dll binary
/src/AccessRelayStudio/Audio/VirtualMicDriver/Package/*.exe binary

# Preserve Authenticode signatures and upstream controller-isolation payloads.
/src/AccessRelayStudio/ControllerIsolation/**/*.exe binary
/src/AccessRelayStudio/ControllerIsolation/**/*.dll binary
/src/AccessRelayStudio/ControllerIsolation/**/*.sys binary
/src/AccessRelayStudio/ControllerIsolation/**/*.cat binary

# Keep the generated Three.js bundle out of language statistics.
/src/AccessRelayStudio/Viewer/viewer.bundle.js linguist-generated
